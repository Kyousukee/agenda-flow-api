# Base de datos (SQL Server)
DB_HOST=localhost
# Instancia con nombre (ej. SQLEXPRESS). Requiere el servicio "SQL Server Browser";
# si se define, el puerto lo resuelve el Browser y DB_PORT se ignora.
# Dejar vacío para conectar por puerto.
DB_INSTANCE=
DB_PORT=1433
DB_USER=
DB_PASS=
DB_NAME=AgendaFlowDB

# JWT
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
# Duración de la sesión: número = segundos (86400 = 24 h) o con unidad (7d, 12h, 30m).
JWT_EXPIRATION=7d

# Cloudinary (subida de logos). Ver https://console.cloudinary.com → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
