# Base de datos (SQL Server)
DB_HOST=localhost
# Instancia con nombre (ej. SQLEXPRESS). Requiere el servicio "SQL Server Browser";
# si se define, el puerto lo resuelve el Browser y DB_PORT se ignora.
# Dejar vacío para conectar por puerto.
DB_INSTANCE=
DB_PORT=1433
DB_USER=
DB_PASS=
DB_NAME=AgendaFlowDB

# JWT
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
# Duración de la sesión: número = segundos (86400 = 24 h) o con unidad (7d, 12h, 30m).
JWT_EXPIRATION=7d

# Cloudinary (subida de logos). Ver https://console.cloudinary.com → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (correos transaccionales). Ver specs/02-correos-reservas-resend.md
# Sin dominio propio usar onboarding@resend.dev (solo entrega al email de tu cuenta Resend).
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# URL pública del front, usada en los enlaces de los correos. Nunca se toma de la petición.
# En producción: https://agendaflow.cl
FRONT_URL=http://localhost:4200

# Orígenes permitidos por CORS, separados por coma.
# En producción: https://agendaflow.cl,https://www.agendaflow.cl
CORS_ORIGINS=http://localhost:4200
# Número de proxies delante de la API (0 si no hay). Necesario para que el rate limiting vea la IP real.
TRUST_PROXY=0

# Login con Google (SPEC 05). Google Cloud Console → APIs y servicios → Credenciales →
# ID de cliente OAuth tipo "Aplicación web". Es el mismo Client ID que usa el front.
# Si se deja vacío, la API arranca pero POST /auth/google responde 503.
GOOGLE_CLIENT_ID=

# Flow (SPEC 06). Sandbox: https://sandbox.flow.cl/api · Producción: https://www.flow.cl/api
# La misma URL se usa para tu cuenta y para las cuentas de los locales.
FLOW_API_URL=https://sandbox.flow.cl/api
# Tu cuenta Flow: recibe la mensualidad Pro. Flow → Mis datos → Integración.
# Si falta alguna de las dos, la API arranca pero POST /suscripcion/pagar responde 503.
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Clave para cifrar las secretKey de los locales: 32 bytes en base64.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde o se cambia, hay que volver a cargar todas las cuentas Flow de los locales.
# Si falta, la API arranca, guardar una cuenta Flow responde 503 y las reservas se crean sin pago.
FLOW_CREDENCIALES_KEY=
# URL pública de esta API. Flow llama aquí los webhooks: en local hace falta un túnel (ngrok, cloudflared).
API_PUBLIC_URL=http://localhost:3000
